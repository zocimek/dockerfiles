#!/bin/sh
# Git credential helper that answers from GH_TOKEN/GITHUB_TOKEN for github.com
# and from GITLAB_TOKEN for GITLAB_HOST. Use it with `credential.helper = env`.
set -eu

[ "${1:-}" = get ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case $key in
        protocol) protocol=$value ;;
        host) host=$value ;;
    esac
done

[ "$protocol" = https ] || exit 0

github_token=${GH_TOKEN:-${GITHUB_TOKEN:-}}

if [ "$host" = github.com ] && [ -n "$github_token" ]; then
    printf 'username=x-access-token\npassword=%s\n' "$github_token"
elif [ -n "${GITLAB_HOST:-}" ] && [ "$host" = "$GITLAB_HOST" ] && [ -n "${GITLAB_TOKEN:-}" ]; then
    printf 'username=oauth2\npassword=%s\n' "$GITLAB_TOKEN"
fi
