{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  customManagers: [
    {
      customType: "regex",
      description: "ARG versions annotated with a renovate comment",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\nARG \\S+=(?<currentValue>\\S+)",
      ],
    },
  ],
}
